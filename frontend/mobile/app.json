{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tru-connect-logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/tru-connect-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/tru-connect-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#111417"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tru-connect-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mobile"
    },
    "web": {
      "favicon": "./assets/images/tru-connect-logo.png"
    },
    "scheme": "truconnect",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      "expo-local-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your current location so you can find your delivery spot faster."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.truconnect.dev/api/v1"
    }
  }
}